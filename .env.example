PEXELS_API_KEY=your_pexels_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# FFmpeg binary paths (if not in system PATH)
FFMPEG_PATH=C:/path/to/ffmpeg.exe
FFPROBE_PATH=C:/path/to/ffprobe.exe

# LLM defaults used by VideoContextAnalyzer when no LLM is passed explicitly
LLM_MODEL_NAME=gemini-2.0-flash
LLM_PROVIDER=google
LLM_SYSTEM_PROMPT=You are an expert video analyst. Return only valid JSON when asked for structured output.
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30

# Optional: override video analysis prompt template used by VideoContextAnalyzer
# Must include {frame_count} placeholder
VIDEO_CONTEXT_ANALYSIS_PROMPT_TEMPLATE=Analyze these {frame_count} frames and return only valid JSON with summary,mood,scene_type,intensity,pace,visual_style,emotion_tags,hook_style_suggestions,best_moment,quality_flags,confidence.
